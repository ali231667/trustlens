# ---------------------------------------------------------------------------
# TrustLens Gateway — copy this file to `.env` and edit.
# Every value has a working default, so an empty .env still runs.
# ---------------------------------------------------------------------------

# ---- Gemini, for the "Why?" explanations ----
# Free key from https://aistudio.google.com/apikey
# Leave blank and explanations fall back to rule-based text — everything else
# still works. NEVER put this key in the extension folder; it belongs here only.
GEMINI_API_KEY=
# Verified working. Don't use the moving aliases like `gemini-flash-latest` —
# one was measured ignoring the no-thinking setting and returning truncated text.
GEMINI_MODEL=gemini-2.5-flash

# ---- where the modules are listening ----
# Classifier    : this folder    uvicorn post_checker_api:app --port 8001
# Account model : this folder    uvicorn follower_api:app     --port 8002
# Both are now served from this repo and wrap the SAME models the TrustLens
# website uses, so the extension and the website cannot disagree.
CLASSIFIER_URL=http://127.0.0.1:8001
FOLLOWER_URL=http://127.0.0.1:8002

# Transcriber (Module 12) is still external and OPTIONAL — not in this repo yet.
# Without it, a reel's spoken audio is reported as "not checked" rather than
# assumed innocent. Note this port collides with the main TrustLens website,
# which also runs on 8000; do not run both.
TRANSCRIBER_URL=http://127.0.0.1:8000

# Where the TrustLens backend lives, so the two wrappers can import its models
# in place. Defaults to this repo's backend/ folder — only set this if you have
# moved things around.
# TRUSTLENS_BACKEND_DIR=D:\trustlens\backend

# ---- this gateway ----
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8100

# ---- timeouts (seconds) ----
FAST_TIMEOUT=60
# Whisper on a CPU runs at roughly realtime, so a 60s reel needs ~60s+.
TRANSCRIBE_TIMEOUT=900
POLL_INTERVAL=1.5
